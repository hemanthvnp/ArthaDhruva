# Variables the MCP servers read. Names only: never commit real values (.env* is ignored).

# risk-engine
RISK_ENGINE_URL=http://localhost:8080            # backend base URL, without /v1
RISK_ENGINE_SESSION=                             # value of the ad_session cookie of a signed-in user (required, secret)
RISK_ENGINE_XSRF=                                # value of the XSRF-TOKEN cookie (optional, secret; fetched from the API when empty)
RISK_ENGINE_TIMEOUT_MS=30000                     # per-request timeout
RISK_ENGINE_MAX_ROWS=100                         # cap on rows a list tool returns (at most 500)
RISK_ENGINE_LIVE=                                # 1 runs the opt-in live smoke test (npm test) against RISK_ENGINE_URL
RISK_ENGINE_LIVE_RUN=                            # 1 also starts a portfolio run in that test (minutes of compute)

# ci-guard
CI_GUARD_REPO=                                   # repository root (default: the git root of the working directory)

# tenant-ops
TENANT_OPS_DATABASE_URL=                         # postgres://... as the APPLICATION role, never arthadhruva_worker (required, secret)
TENANT_OPS_TENANT_ID=                            # the organization to serve (required); must match the session's organization
TENANT_OPS_TIMEOUT_MS=30000                      # per-request timeout of the audit and usage calls
TENANT_OPS_DB_STATEMENT_TIMEOUT_MS=5000          # per-statement timeout in the database
# (RISK_ENGINE_URL and RISK_ENGINE_SESSION above must be an ADMINISTRATOR's session for /admin/audit-log and /admin/usage)

# model-validation
MODEL_VALIDATION_REPO=                           # repository root (default: the git root of the working directory)
MODEL_VALIDATION_TIMEOUT_MS=30000                # timeout of the drift and backtest report calls (RISK_ENGINE_SESSION needed for those)

# deploy-ops (all optional)
DEPLOY_OPS_PROMETHEUS_URL=http://localhost:9090  # Prometheus base URL
DEPLOY_OPS_APP_URL=                              # public application URL, to see whether it answers
DEPLOY_OPS_WAKE_URL=                             # public wake function URL (deploy/azure/wake); needed by `wake`
DEPLOY_OPS_AZ_RESOURCE_GROUP=                    # with DEPLOY_OPS_AZ_VM: read the VM's power state with az
DEPLOY_OPS_AZ_VM=
DEPLOY_OPS_TIMEOUT_MS=3000                       # per-attempt timeout of each network call
DEPLOY_OPS_RETRIES=2                             # retries after the first attempt (0 to 3)

# analyst agent (ANTHROPIC_API_KEY, or `ant auth login`, is read by the SDK itself and is not listed here)
AGENT_TENANT_ID=                                 # the organization the agent works for, fixed for the run (required)
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high                                # low, medium, high, xhigh, max
AGENT_REFUSAL_FALLBACK=on                        # on re-runs a safety decline on a fallback model; off disables
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MAX_STEPS=12                               # model calls per question
AGENT_MAX_TOKENS=300000                          # input plus output tokens per question
AGENT_MAX_SECONDS=180
AGENT_MAX_COST_USD=2                             # estimated; "none" to rely on the token limit; needs prices for non-built-in models
AGENT_PRICE_INPUT_PER_MTOK=                      # dollars per million input tokens (built in for claude-opus-5-5)
AGENT_PRICE_OUTPUT_PER_MTOK=
AGENT_TRACE_DIR=.agent-traces
AGENT_EVAL_CAP_USD=                              # MANDATORY spending cap of the live eval suites (npm run eval:*)
AGENT_EVAL_REPORTS=                              # where eval reports go (default agent/evals/reports)
