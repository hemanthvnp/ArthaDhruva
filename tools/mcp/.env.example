# Variables the MCP servers read. Names only: never commit real values (.env* is ignored).

# risk-engine
RISK_ENGINE_URL=http://localhost:8080            # backend base URL, without /v1
RISK_ENGINE_SESSION=                             # value of the ad_session cookie of a signed-in user (required, secret)
RISK_ENGINE_XSRF=                                # value of the XSRF-TOKEN cookie (optional, secret; fetched from the API when empty)
RISK_ENGINE_TIMEOUT_MS=30000                     # per-request timeout
RISK_ENGINE_MAX_ROWS=100                         # cap on rows a list tool returns (at most 500)
RISK_ENGINE_LIVE=                                # 1 runs the opt-in live smoke test (npm test) against RISK_ENGINE_URL
RISK_ENGINE_LIVE_RUN=                            # 1 also starts a portfolio run in that test (minutes of compute)

# ci-guard
CI_GUARD_REPO=                                   # repository root (default: the git root of the working directory)
