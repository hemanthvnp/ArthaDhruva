# Keep LF for anything executed or mounted into Linux containers (CRLF breaks /bin/sh and nginx envsubst)
* text=auto
*.sh text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.sql text eol=lf
*.service text eol=lf
*.timer text eol=lf

# Files without an extension that Linux containers read
Caddyfile text eol=lf
.env.example text eol=lf

# Checksummed text artifacts: the model card declares the sha256 of the LF bytes, and the service refuses
# to start on a mismatch, so a Windows checkout must not convert them to CRLF
backend/risk-engine/src/main/resources/segment_graph.json text eol=lf
