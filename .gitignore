# Source ZIPs and all pipeline outputs -- regenerate locally by running the
# pipeline against your own copy of the raw ZIPs (fully deterministic, so
# results are byte-identical). Too large for git (raw ~9GB, processed ~53GB).
historical_data_*/
data/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Claude Code local session state
.claude/

# Logs / scratch
*.log

# Internal planning/reference docs and pitch decks -- not for the public repo
ARTHADHRUVA_PROJECT_SPEC.md
docs/

# Backend: Maven build output, build logs, and the cached training checkpoint (127MB,
# regenerable by re-running export_model.py against ../data -- the ONNX model itself IS
# committed, since it's a small, deployable artifact the running service actually needs).
backend/risk-engine/target/
backend/trained_checkpoint.joblib
backend/early_warning_trained_checkpoint.joblib
backend/run_log.txt

# Local file storage for loan attachments (attachments.storage-dir's default) -- runtime data,
# not source; a real deployment points this at a real volume or swaps in an S3-backed
# FileStorageService implementation instead.
backend/risk-engine/data/

# Exploratory scratch scripts (not part of the reproducible pipeline/notebooks)
notebooks/_scratch_*

# Machine-local docker-compose port remaps (e.g. when another project already holds 6379) --
# not something to share, everyone's local port conflicts differ.
docker-compose.override.yml

# Generated secrets (scripts/gen-secrets.sh) -- never commit
secrets/
