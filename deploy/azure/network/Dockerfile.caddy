# DEVELOPMENT ONLY. Caddy with the Azure DNS module, for the wildcard certificate in Caddyfile.wildcard.
# Not referenced by any docker-compose file or deploy script: production uses the stock caddy image.
#
#   docker build -f Dockerfile.caddy -t arthadhruva-caddy-azure:dev .
#
# Runs as a non-root user (uid/gid 10001). The caddy binary keeps its file capability cap_net_bind_service, and the
# launch in README.md grants that capability with --cap-drop ALL --cap-add NET_BIND_SERVICE, which is what lets
# a non-root process bind ports 80 and 443. Both halves are needed: with the file capability and no --cap-add the
# binary fails to start ("operation not permitted"). /data and /config belong to the caddy user, and a NEW named
# volume inherits that ownership; a volume created earlier by a root image keeps root ownership and must be
# removed or chowned. Base images are pinned by tag, not by digest.
#
# Versions are pinned. 2.11 is the line whose Host-header behaviour Caddyfile.wildcard accounts for; the module
# is its latest release when this was written (v0.6.0). The pair builds (Caddy v2.11.6) and Caddyfile.wildcard
# passes `caddy validate` on the result. It has not been used to issue a certificate or to serve live traffic.
FROM caddy:2.11-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/azure@v0.6.0

FROM caddy:2.11
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
RUN addgroup -S -g 10001 caddy \
    && adduser -S -D -H -u 10001 -G caddy -h /nonexistent caddy \
    && chown -R caddy:caddy /data /config
USER caddy
