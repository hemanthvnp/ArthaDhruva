# Server-side settings. On the server: cp deploy/.env.example .env  and edit. The real .env is
# git-ignored. Credentials that guard data (database, JWT, 2FA key) are NOT here: they live in
# secrets/ (generated by scripts/gen-secrets.sh) and reach the containers as Docker secrets.

# The public hostname. Caddy gets a Let's Encrypt certificate for exactly this name.
# Free options: a DuckDNS name (yourname.duckdns.org) or, with no signup, <server-ip-with-dashes>.sslip.io
SITE_ADDRESS=app.yourname.duckdns.org

# Same origin as SITE_ADDRESS (the frontend and the API are served from one host).
APP_PUBLIC_URL=https://app.yourname.duckdns.org
FRONTEND_URL=https://app.yourname.duckdns.org

# Login by organization slug works everywhere. Subdomain login (acme.yourdomain.com) needs a real
# domain with wildcard DNS and a wildcard certificate; leave APP_BASE_DOMAIN empty otherwise.
AUTH_ORG_SLUG_LOGIN_ENABLED=true
APP_BASE_DOMAIN=

# First-run bootstrap admin for the default organization. If left empty, a random password is printed
# once in the backend log on first boot (docker compose logs backend | grep -A3 Username).
ADMIN_PASSWORD=
# Optional cross-tenant platform administrator. Leave empty to disable it.
PLATFORM_ADMIN_PASSWORD=

# Webhooks must never be allowed to target private addresses on an internet-facing server.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Trace sampling: keep low on a small server.
TRACE_SAMPLING=0

# Optional SMTP so password-reset emails are delivered (Brevo, Resend and Gmail app passwords all
# have free tiers). Without it the reset endpoints still respond but no email leaves the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
